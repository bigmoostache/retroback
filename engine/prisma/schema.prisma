// Retroback: plan backward from a target (future) to now (present).
//
// A Plan fixes one measurable metric, its value today (presentValue) and the
// value aimed at (targetValue). Nodes are created from the target backward.
// Each node states the metric level reached once it is done. The gap between a
// node and the former nodes it depends on must stay within plan.gapPercent
// (the 1% rule): small steps, each one reachable from the one before.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NodeStatus {
  todo
  doing
  done
}

model Plan {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  /// The target statement: what is true in the future.
  target       String
  /// What is measured to tell how far along we are.
  metric       String
  unit         String
  presentValue Float
  targetValue  Float
  /// Maximum allowed gap between a node and what it depends on, in percent.
  gapPercent   Float    @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  nodes        Node[]
  /// Who can see and change the plan: its creator (the owner) and contributors.
  members      PlanMember[]
}

enum PlanRole {
  owner
  contributor
}

/// A person, known by the email Google gave (or local@dev when DEV=true).
model User {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String       @default("")
  createdAt DateTime     @default(now())
  sessions  Session[]
  apiKeys   ApiKey[]
  plans     PlanMember[]
}

/// A web login. Only the hash of the cookie token is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

/// A named key for rb, acting as its user. Only the hash of the secret is stored.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// The first characters of the secret, to recognise it in a list.
  prefix     String
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@unique([userId, name])
}

/// Access to a plan. Exactly one owner per plan: its creator.
model PlanMember {
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PlanRole
  createdAt DateTime @default(now())

  @@id([planId, userId])
  @@index([userId])
}

model Node {
  id           String         @id @default(cuid())
  planId       String
  plan         Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Short handle, unique in the plan: N1 is the target, numbers grow backward.
  ref          String
  seq          Int
  title        String
  description  String         @default("")
  /// Metric value reached once this node is done.
  level        Float
  status       NodeStatus     @default(todo)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  criteria     Criterion[]
  /// What must be true before work on this node can start, each provided by one former node.
  requirements Requirement[]  @relation("Requires")
  resources    ResourceNeed[]
  messages     Message[]
  /// How big the node is, from 0 (tiny) to 100 (largest).
  size         Int            @default(50)
  /// Requirements of later nodes that this node provides.
  provides     Requirement[]  @relation("Provides")

  @@unique([planId, ref])
  @@unique([planId, seq])
}

/// A success criterion: precise and checkable. Addressed by its slug, unique in the node.
model Criterion {
  id       String  @id @default(cuid())
  nodeId   String
  node     Node    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  slug     String
  /// Display order only: never used to address the criterion.
  position Int
  text     String
  met      Boolean @default(false)

  @@unique([nodeId, slug])
  @@index([nodeId, position])
}

/// Something that must be true before work on the node can start. Exactly one
/// former node provides it, and it is met once that node is done. These links
/// are the edges of the graph.
model Requirement {
  id         String @id @default(cuid())
  nodeId     String
  node       Node   @relation("Requires", fields: [nodeId], references: [id], onDelete: Cascade)
  slug       String
  /// Display order only: never used to address the requirement.
  position   Int
  text       String
  providerId String
  provider   Node   @relation("Provides", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([nodeId, slug])
  @@index([nodeId, position])
  @@index([providerId])
}

/// A resource a node needs. `kind` is free text: human, computing, capital,
/// machine, or anything else. Addressed by its slug, unique in the node.
model ResourceNeed {
  id       String @id @default(cuid())
  nodeId   String
  node     Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  slug     String
  /// Display order only: never used to address the resource.
  position Int
  kind     String
  name     String
  quantity Float
  unit     String

  @@unique([nodeId, slug])
  @@index([nodeId, position])
}

/// A message under a node: a note, a question, a decision. Written by a person
/// or an agent; `author` is free text. Addressed by `handle` (m-xxxxxx).
model Message {
  id        String    @id @default(cuid())
  nodeId    String
  node      Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  handle    String
  /// Display order only: never used to address the message.
  position  Int
  author    String
  text      String
  createdAt DateTime  @default(now())
  /// Set when the text changes after it was posted.
  editedAt  DateTime?

  @@unique([nodeId, handle])
  @@index([nodeId, position])
}

/// One operation that changes data, as it was asked: who, when, through what,
/// and how it ended. Append only: the database refuses any change or deletion.
/// Replaying the ok events in order rebuilds the data.
model Event {
  seq    Int      @id @default(autoincrement())
  at     DateTime @default(now())
  /// Who asked for it.
  actor  String
  /// Where it came from: cli, api, seed or replay.
  via    String
  op     String
  /// Slug of the plan it touched, when there is one.
  plan   String?
  /// The input it ran with, defaults filled in.
  input  Json
  ok     Boolean
  /// Error code and message when it failed.
  error  String?

  @@index([plan, seq])
}
