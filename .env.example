# Copy to .env (git-ignored) and fill in.

# true: no Google, the web app is signed in as local@dev. Never in production.
DEV=true

# Google OAuth client (Google Cloud console > APIs & Services > Credentials).
# Authorised redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the web app is served.
PUBLIC_URL=http://127.0.0.1:5190

# DATABASE_URL=postgresql://retroback:retroback@127.0.0.1:55440/retroback
# RETROBACK_API_PORT=7979
